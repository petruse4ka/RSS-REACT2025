{
  "name": "rss-react2025-project1",
  "version": "1.0.0",
  "description": "First personal project for the React 2025 course at RS School",
  "homepage": "http://petruse4ka.github.io/RSS-REACT2025/first-project",
  "bugs": {
    "url": "https://github.com/petruse4ka/RSS-REACT2025/issues"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petruse4ka/RSS-REACT2025.git"
  },
  "license": "ISC",
  "author": "Konstantin Petrov",
  "type": "module",
  "scripts": {
    "check": "npm run lint && npm run format:check",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,css,scss}\"",
    "format:check": "prettier --list-different \"src/**/*.{ts,tsx,js,jsx,css,scss}\"",
    "format:fix": "prettier --write --ignore-unknown \"src/**/*.{ts,tsx,js,jsx,css,scss}\"",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\" --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js}\" --ext .ts,.tsx,.js,.jsx --fix",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx gh-pages -d dist -e first-project"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.0.0-beta-af1b7da-20250417",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
